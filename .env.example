# Copy to .env.local and fill in what you have. Everything is optional in development.

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Postwise
# Base URL platforms use to pull media (must be public HTTPS in production, e.g. an R2/CDN domain)
MEDIA_PUBLIC_URL=
DATA_DIR=./data

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# First user to sign up becomes platform admin; or set this email.
ADMIN_EMAIL=

# --- AI (Claude). Without a key the composer uses an offline formatter. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Publisher worker ---
WORKER_ENABLED=true
WORKER_INTERVAL_MS=15000
CRON_SECRET=

# --- Email (Resend). Without a key, emails are logged to the console. ---
RESEND_API_KEY=
EMAIL_FROM="Postwise <noreply@yourdomain.com>"

# --- Google: sign-in + YouTube (OAuth client, redirect URIs:
#     {APP_URL}/api/auth/google/callback and {APP_URL}/api/connect/youtube/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta: Facebook Pages + Instagram (redirect: {APP_URL}/api/connect/facebook/callback and /instagram/callback) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# --- LinkedIn (redirect: {APP_URL}/api/connect/linkedin/callback) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202509
# true once Community Management API is approved
LINKEDIN_COMPANY_PAGES=false

# --- TikTok (redirect: {APP_URL}/api/connect/tiktok/callback) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- WhatsApp Status gateway (unofficial; feature-flagged) ---
WHATSAPP_GATEWAY_URL=https://gate.whapi.cloud
WHATSAPP_STATUS_DAILY_CAP=5

# --- Paystack (webhook: {APP_URL}/api/billing/paystack/webhook) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_STARTER_MONTHLY=
PAYSTACK_PLAN_STARTER_YEARLY=
PAYSTACK_PLAN_GROWTH_MONTHLY=
PAYSTACK_PLAN_GROWTH_YEARLY=
PAYSTACK_PLAN_AGENCY_MONTHLY=
PAYSTACK_PLAN_AGENCY_YEARLY=

# --- Local development test account (only for a local dev database) ---
DEV_TEST_EMAIL=owner@demo.test
DEV_TEST_PASSWORD=demo-pass-8421
